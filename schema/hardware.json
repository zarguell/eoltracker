{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zarguell.github.io/eoltracker/v1/schema/hardware.json",
  "title": "EOL Tracker normalized hardware record (not OpenEoX Core)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "name",
    "category",
    "vendor",
    "product_line",
    "milestones",
    "status",
    "upstream",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "const": "https://zarguell.github.io/eoltracker/v1/schema/hardware.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "const": "hardware"
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "product_line": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string"
    },
    "model_number": {
      "type": "string"
    },
    "upstream": {
      "type": "object"
    },
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ga", "eos", "eossec", "eol"],
      "properties": {
        "ga": {"type": ["string", "null"], "format": "date"},
        "eos": {"type": ["string", "null"], "format": "date"},
        "eossec": {"type": ["string", "null"], "format": "date"},
        "eol": {"type": ["string", "null"], "format": "date"}
      }
    },
    "status": {
      "enum": ["supported", "expiring", "eol", "unknown"]
    },
    "catalog": {
      "description": "Opengear configurator listing evidence: whether the current catalog offers this exact SKU. Listing is not support entitlement, and removal from the catalog is not an end of life.",
      "type": "object",
      "additionalProperties": false,
      "required": ["listed", "source_url"],
      "properties": {
        "listed": {"type": "boolean"},
        "source_url": {"const": "https://opengear.com/configure/"}
      }
    },
    "lifecycle": {
      "description": "The lifecycle group/revision records whose published part scope names this exact SKU, and whether any such notice exists now. An unknown state is never invented: an empty match list with listed false means no notice names this SKU.",
      "type": "object",
      "additionalProperties": false,
      "required": ["listed", "matches"],
      "properties": {
        "listed": {"type": "boolean"},
        "matches": {
          "type": "array",
          "items": {"type": "string", "pattern": "^opengear-"}
        }
      }
    },
    "evidence": {
      "description": "Set when a committed record is retained although the current source snapshot no longer states it. Its milestones and raw upstream cells stay unchanged; an absent source row is neither a support claim nor an end of life.",
      "type": "object",
      "additionalProperties": false,
      "required": ["in_source"],
      "properties": {
        "in_source": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_urls", "verifier", "last_checked"],
      "properties": {
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "format": "uri"}
        },
        "verifier": {
          "enum": ["deterministic-eosl-date", "deterministic-opengear"]
        },
        "last_checked": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
