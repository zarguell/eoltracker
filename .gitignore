.venv/
__pycache__/
*.pyc
_site/
.DS_Store
# Local secrets. A .env holds API keys (the exposure probe reads SHODAN_API_KEY
# from it); it must never be staged, committed, or published with the site.
.env
.env.*
!.env.example
# Reviewed, installable contributions live at the top of contributions/ and are
# committed; the CLI reads exactly `contributions/*.json`. Work in progress
# belongs in a subdirectory, which the CLI never reads and git never tracks.
contributions/drafts/
